# Local virtual environment
.venv/

# Python caches and packaging metadata (regenerated by every install/build)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# SwiftPM build products
.build/

# Generated output (see README "Repository layout"):
#   dist/python = wheels and sdist for the mantis-xray distribution
#   dist/GUI    = Mantis.app and the DMG
# Build intermediates live in a temporary directory and are removed on exit;
# /build/ is ignored only so a manual `pyinstaller` run cannot dirty the tree.
/dist/
/build/

# Local backup of the pre-migration Qt code; safe to delete at any time
/old/

# Measurement data must never be committed: a single stack is hundreds of MB.
# Keep test data outside the repository, or add it here deliberately per file.
*.hdf5
*.h5
*.nxs
*.stk
*.xrm
*.txrm
*.ncb
*.sm
*.npz
# Local beamline source files are never part of the public code history.
/docs/Sol_240309145/

# Editor/agent atomic-write intermediates
.hermes-tmp.*

# macOS
.DS_Store
